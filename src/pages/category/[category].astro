---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import { getNotes, getCategories, type Note } from '../../lib/notes';
export async function getStaticPaths() {
  const notes = await getNotes();
  return getCategories(notes).map(({ name }) => ({
    params: { category: name },
    props: {
      category: name,
      notes: notes.filter((note) => note.data.category === name),
    },
  }));
}
interface Props {
  category: string;
  notes: Note[];
}
const { category, notes } = Astro.props;
---

<SiteLayout
  title={category}
  description={`${category}分类下的文章。`}
  section="/archive/"
  noindex={!notes.some((note) => !note.data.example)}
>
  <div class="simple-content">
    <a class="article-back" href="/archive/">
      ← 所有文章
    </a>
    <header class="page-intro">
      <h1>{category}</h1>
      <p>{notes.length} 篇文章</p>
    </header>
    <ArchiveList notes={notes} />
  </div>
</SiteLayout>
