---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import { getNotes, noteUrl, dateLabel, type Note } from '../../lib/notes';
export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: { note, newer: notes[index - 1], older: notes[index + 1] },
  }));
}
interface Props {
  note: Note;
  newer?: Note;
  older?: Note;
}
const { note, newer, older } = Astro.props;
const { Content } = await render(note);
---

<SiteLayout
  title={note.data.title}
  description={note.data.description}
  noindex={note.data.example}
  article={note.data}
>
  <article class="article-content">
    <a class="article-back" href="/">
      ← 首页
    </a>
    <header class="article-header">
      <h1>{note.data.title}</h1>
      <PostMeta note={note} />
      {note.data.updated && (
        <p class="updated-date">
          更新于{' '}
          <time datetime={note.data.updated.toISOString()}>
            {dateLabel(note.data.updated)}
          </time>
        </p>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <nav aria-label="文章导航" class="article-bottom">
      {newer && (
        <a href={noteUrl(newer.id)} rel="prev">
          ← {newer.data.title}
        </a>
      )}
      {older && (
        <a href={noteUrl(older.id)} rel="next">
          {older.data.title} →
        </a>
      )}
    </nav>
  </article>
</SiteLayout>
