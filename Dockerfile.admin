FROM node:22.23.1-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY admin ./admin
COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY astro.config.mjs tsconfig.json ./
RUN mkdir -p /app/.admin /app/public/images /published \
    && chown -R node:node /app /published
USER node
ENV ADMIN_HOST=0.0.0.0 ADMIN_PORT=4330 ADMIN_PUBLISH_DIR=/published
EXPOSE 4330
CMD ["node", "admin/server.mjs"]
