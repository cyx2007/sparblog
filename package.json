{
  "name": "sparsity-tech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "verify": "npm run check && npm run build && node scripts/verify-build.mjs",
    "test:publishing": "node scripts/verify-publishing.mjs",
    "test:admin": "node --test tests/admin.test.mjs",
    "test:admin:browser": "node tests/admin-browser.mjs",
    "admin": "node --env-file-if-exists=.env admin/server.mjs",
    "admin:reset-password": "node --env-file-if-exists=.env admin/reset-password.mjs",
    "new:post": "node scripts/new-post.mjs",
    "release": "npm run verify && node scripts/package-release.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "astro": "7.3.3",
    "easymde": "2.21.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.58.2",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "5.9.3"
  }
}
