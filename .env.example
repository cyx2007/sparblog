# Local Docker preview: http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# For production after DNS points at your Ubuntu server:
# SITE_ADDRESS=sparsity.tech
# HTTP_PORT=80
# HTTPS_PORT=443

# Optional administration service (npm run admin)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4330
# Default origin is http://127.0.0.1:4330 for local use.
# For a server behind Caddy, set the exact HTTPS origin:
# ADMIN_ORIGIN=https://sparsity.tech
# ADMIN_STATE_DIR=.admin
# ADMIN_PUBLISH_DIR=published
